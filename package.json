{
  "name": "@xfold/cli",
  "version": "0.1.0",
  "description": "Explore committed code as semantic graphs",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "xfold": "bin/xfold.mjs"
  },
  "files": [
    "bin",
    "native",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "SPEC.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "build:native": "node scripts/cargo.mjs build --release",
    "build": "npm run build:web && npm run build:native && npm run licenses && node scripts/package-native.mjs",
    "test": "node scripts/cargo.mjs test --lib --tests && node --test tests/launcher.test.mjs",
    "test:browser": "playwright test",
    "test:matplotlib": "python3 scripts/benchmark.py",
    "generate:api": "node scripts/generate-api.mjs",
    "check": "tsc -p web/tsconfig.json --noEmit",
    "licenses": "node scripts/collect-licenses.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@xyflow/react": "^12.10.0",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "elkjs": "^0.11.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.58.0",
    "openapi-typescript": "^7.10.0"
  },
  "optionalDependencies": {
    "@xfold/darwin-arm64": "0.1.0",
    "@xfold/darwin-x64": "0.1.0",
    "@xfold/linux-arm64": "0.1.0",
    "@xfold/linux-x64": "0.1.0",
    "@xfold/win32-x64": "0.1.0"
  }
}
